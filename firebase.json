{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase-debug.log",
      "**/.*",
      "tests/**",
      "pyproject.toml",
      "mise.toml",
      "uv.lock",
      ".python-version",
      "**/README.md"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/pages/index.html"
      }
    ]
  }
}
