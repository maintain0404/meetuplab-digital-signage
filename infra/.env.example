# OpenTofu 환경 변수 설정
# 사용 방법: cp .env.example .env 후 값을 수정하고 source .env 실행

# GCP 프로젝트 설정
export TF_VAR_project_id="your-gcp-project-id"
export TF_VAR_region="asia-northeast3"
export TF_VAR_bucket_name="meetuplab-signage"
export TF_VAR_environment="production"

# GCP 인증 (선택사항)
# export GOOGLE_CREDENTIALS="/path/to/service-account-key.json"
# export GOOGLE_CLOUD_PROJECT="your-gcp-project-id"

# OpenTofu 디버그 모드 (선택사항)
# export TF_LOG="DEBUG"
